{
  "name": "@35mm/validators",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./username": {
      "types": "./src/username.ts",
      "default": "./src/username.ts"
    },
    "./email": {
      "types": "./src/email.ts",
      "default": "./src/email.ts"
    },
    "./date-of-birth": {
      "types": "./src/dateOfBirth.ts",
      "default": "./src/dateOfBirth.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@35mm/config": "workspace:*",
    "@35mm/types": "workspace:*"
  }
}
